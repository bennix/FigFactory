    "ag-psd": "^31.0.2",
    "pngjs": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "FigFactory contributors"
  },
  "homepage": "https://bennix.github.io/FigFactory/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bennix/FigFactory.git"
  }
