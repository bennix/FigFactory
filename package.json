{
  "name": "body-factory",
  "productName": "BodyFactory 形体工坊",
  "version": "1.0.1",
  "description": "AI image creation studio with pose references, image editing and layered PSD export",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "python3 -m http.server 5173",
    "test": "node --test tests/zenmux.cjs tests/psd.cjs tests/zenmux-errors.cjs tests/zenmux-stream.cjs",
    "test:desktop": "electron tests/desktop.cjs",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "license": "MIT",
